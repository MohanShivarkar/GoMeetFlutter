{
  "outputDirectory": "build/web",
  "public": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://gomeet.cscodetech.cloud/api/$1" },
    {
      "source": "/((?!assets|icons|flutter_service_worker\\.js|flutter_bootstrap\\.js|main\\.dart\\.js|flutter\\.js|manifest\\.json|favicon\\.png|version\\.json).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/flutter_service_worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https://gomeet.cscodetech.cloud https://*.firebaseapp.com https://*.googleapis.com https://*.firebaseio.com; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https://gomeet.cscodetech.cloud http://127.0.0.1:8000 wss://*.firebaseio.com https://*.googleapis.com; font-src 'self' data:; media-src 'self' blob:; worker-src 'self';"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
